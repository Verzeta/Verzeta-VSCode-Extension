# Verzeta VS Code Extension — npm configuration.
#
# Every setting here is a deliberate supply-chain-defense choice.
# Do NOT relax any of these without reviewing
# Documentation/Standards/SUPPLY-CHAIN-DEFENSE.md first.

# CRITICAL: disable lifecycle scripts (preinstall, install,
# postinstall) on every dependency. This is the primary attack
# vector used by the Shai-Hulud npm attack (Sept 2025) and most
# other npm supply-chain attacks. A compromised package cannot
# execute arbitrary code on a contributor's machine if scripts
# are disabled.
ignore-scripts=true

# Exact-pin every dependency. No "^" or "~" semver ranges in
# package.json. Eliminates the silent-update attack window where
# a malicious patch release ships under a permissive range.
save-exact=true

# Fail npm install / npm audit on any moderate-or-higher
# advisory. We treat advisories as production-blocking.
audit-level=moderate

# No funding messages cluttering output.
fund=false

# Always write package-lock.json. Lockfile-strict installs
# (npm ci) require this.
package-lock=true

# Enforce the engines field in package.json. Refuses install if
# Node / npm versions don't match — keeps the dev environment
# pinned across the team.
engine-strict=true

# Don't auto-update package.json on `npm install` — only manual,
# reviewed dependency additions land in the manifest.
save-prefix=""

# Use registry over HTTPS only.
registry=https://registry.npmjs.org/
